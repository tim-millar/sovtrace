# Live SQL generation requires a credential. CLI schema inference defaults on for unresolved
# required or optional concepts; Python API inference defaults off. --no-infer-schema
# prevents inference requests. Export configuration in your shell.
# The application does not load .env files automatically.
# OPENAI_API_KEY=<your-api-key>
# OPENAI_MODEL=gpt-6-luna
# Optional explicit Mini override: OPENAI_MODEL=gpt-5.4-mini

# Independent schema-inference model (provisional default, low reasoning effort):
# OPENAI_SCHEMA_MODEL=gpt-6-luna
